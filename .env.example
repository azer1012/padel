# =============================================================================
#  Smash Padel — environment variables
#  Copy to .env (never commit .env). Every value below marked <…> is yours to fill.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
#  PUBLIC — compiled into the website (VITE_*). Anyone can read these.
#  Never put a secret in a VITE_ variable.
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://bnbdeymvdfrklbegwfgd.supabase.co
# Dashboard → Project Settings → API Keys → "anon" (legacy) or "publishable" key
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Public address of the website, no trailing slash (canonical URL, sitemap, Open Graph)
VITE_SITE_URL=https://<your-production-domain>

# Show "Continue with Google" only once the provider is configured (GOOGLE_AUTH_SETUP.md)
VITE_AUTH_GOOGLE_ENABLED=false

# Club identity shown on the site. Empty contact channels are simply hidden.
VITE_CLUB_NAME="Smash Padel"
VITE_CLUB_ADDRESS="Les Berges du Lac"
VITE_CLUB_POSTAL="1053 Tunis, Tunisie"
VITE_CLUB_HOURS="08:00 – 23:00"
VITE_CLUB_TIMEZONE=Africa/Tunis
VITE_CLUB_PHONE=
# Defaults to VITE_CLUB_PHONE
VITE_CLUB_WHATSAPP=
VITE_CLUB_EMAIL=
VITE_CLUB_INSTAGRAM=
VITE_CLUB_FACEBOOK=

# ─────────────────────────────────────────────────────────────────────────────
#  SERVER ONLY — API server environment. Never in the browser, never committed.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Postgres connection (Dashboard → Connect → "Session pooler" for IPv4 hosts).
# The API uses this privileged role; browsers have no direct table access.
DATABASE_URL=postgresql://postgres.bnbdeymvdfrklbegwfgd:<db-password>@<pooler-host>:5432/postgres

# Same project URL as above; the anon key falls back to VITE_SUPABASE_ANON_KEY
SUPABASE_URL=https://bnbdeymvdfrklbegwfgd.supabase.co
# Dashboard → Project Settings → API Keys → "service_role" (secret)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Optional, recommended: verify access tokens locally instead of calling Supabase
# Auth on every request (Dashboard → Project Settings → JWT Keys → legacy JWT secret).
# Leave empty if the project signs sessions with asymmetric keys.
SUPABASE_JWT_SECRET=

# Browser origin(s) allowed to call the API (comma-separated) and the site URL
# used in e-mails and invite links
CORS_ORIGIN=https://<your-production-domain>
FRONTEND_URL=https://<your-production-domain>
# true when the API runs behind a proxy/load balancer (needed for per-IP rate limiting)
TRUST_PROXY=true

# Club time. The booking grid and e-mails use it.
TZ=Africa/Tunis
CLUB_TIMEZONE=Africa/Tunis
CLUB_NAME="Smash Padel"
CLUB_ADDRESS="Les Berges du Lac, 1053 Tunis"

# Booking rules
# Players can cancel (full refund) until this many hours before the match. 0 = until it starts.
CANCELLATION_NOTICE_HOURS=0
# Max write requests per IP per minute (0 = off)
RATE_LIMIT_WRITES_PER_MINUTE=60

# Transactional e-mails sent by the API (booking confirmations, reminders, tokens).
# Without RESEND_API_KEY they are only logged. Auth e-mails (confirm, reset) are
# sent by Supabase Auth: configure its SMTP in the dashboard (see docs/PRODUCTION_SETUP.md).
RESEND_API_KEY=
EMAIL_FROM="Smash Padel <notifications@<your-domain>>"
EMAIL_REPLY_TO=contact@<your-domain>

# Web push (installable app). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@<your-domain>

# Scheduled jobs (2 h reminders, "match finished" e-mails)
# true  = the API runs them every 5 minutes (long-running server)
# false = call POST /api/internal/jobs/run with header x-cron-secret from a cron
JOBS_ENABLED=true
CRON_SECRET=
