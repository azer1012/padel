# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://bnbdeymvdfrklbegwfgd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Database
DATABASE_URL=postgresql://postgres:your_password@db.bnbdeymvdfrklbegwfgd.supabase.co:5432/postgres

# Frontend (Vite)
VITE_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY}

# Mobile (Expo)
EXPO_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
EXPO_PUBLIC_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY}

# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ─── Server timezone (REQUIRED in production) ─────────────────────────────────
# The booking calendar builds slots in the server's local time. Without this,
# a UTC host opens the courts at 09:00 Tunis time instead of 08:00.
TZ=Africa/Tunis

# ─── Club identity (emails, push notifications) ──────────────────────────────
CLUB_NAME="Smash Padel"
CLUB_TIMEZONE=Africa/Tunis
CLUB_ADDRESS="Les Berges du Lac, 1053 Tunis"
# FRONTEND_URL (above) is also used for links in emails and notifications

# ─── Email (Resend: https://resend.com) ───────────────────────────────────────
# Without RESEND_API_KEY, emails are only written to the server log.
RESEND_API_KEY=
# Must be on a domain verified in Resend
EMAIL_FROM="Smash Padel <notifications@your-club-domain.tn>"
EMAIL_REPLY_TO=contact@your-club-domain.tn

# ─── Web push (installable app notifications) ────────────────────────────────
# Generate once: npx web-push generate-vapid-keys
# Never change them afterwards, or every device must re-subscribe.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@your-club-domain.tn

# ─── Scheduled jobs (2 h reminders, "match finished" emails) ──────────────────
# true  = the API runs them every 5 minutes (long-running servers)
# false = call POST /api/internal/jobs/run from an external cron with header x-cron-secret
JOBS_ENABLED=true
CRON_SECRET=
