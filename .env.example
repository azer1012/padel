# =============================================================================
#  Padel club platform — environment of ONE installation (one club, one
#  Supabase project, one deployment). Copy to .env and fill every <…>.
#  Never commit .env. Operational rules (prices, match duration, opening hours,
#  tokens, features) are NOT here: admins edit them in the app (Admin → Réglages).
#  See docs/CONFIGURATION.md for what goes where.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
#  PUBLIC — compiled into the website (VITE_*). Anyone can read these.
#  Never put a secret in a VITE_ variable.
# ─────────────────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Dashboard → Project Settings → API Keys → "anon" (legacy) or "publishable" key
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Public address of the website, no trailing slash (canonical URL, sitemap, Open Graph)
VITE_SITE_URL=https://<club-domain>
# Only when the API is on another origin than the website (default: same origin, /api)
VITE_API_URL=

# Sign-in providers. Turn on only once configured (docs/GOOGLE_AUTH_CONFIGURATION.md)
VITE_AUTH_GOOGLE_ENABLED=false
# Apple is prepared but not built yet: leave false
VITE_AUTH_APPLE_ENABLED=false

# Club branding (design-time, per customer). Empty contact channels are hidden.
VITE_CLUB_NAME="<Club name>"
VITE_CLUB_SHORT_NAME="<Short name for the phone home screen>"
VITE_CLUB_TAGLINE="Réservez un terrain ce soir"
VITE_CLUB_DESCRIPTION="<One sentence for Google and link previews>"
VITE_CLUB_THEME_COLOR=#0A1030
VITE_CLUB_ADDRESS="<Street>"
VITE_CLUB_POSTAL="<Postcode City, Country>"
VITE_CLUB_CITY=<City>
VITE_CLUB_COUNTRY=<ISO country code, e.g. TN>
# Defaults to address + postal
VITE_CLUB_MAPS_QUERY=
VITE_CLUB_TIMEZONE=Africa/Tunis
VITE_CLUB_PHONE=
# Defaults to VITE_CLUB_PHONE
VITE_CLUB_WHATSAPP=
VITE_CLUB_EMAIL=
VITE_CLUB_INSTAGRAM=
VITE_CLUB_FACEBOOK=

# ─────────────────────────────────────────────────────────────────────────────
#  SERVER ONLY — API server environment. Never in the browser, never committed.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Postgres connection (Dashboard → Connect → "Session pooler" for IPv4 hosts).
# The API uses this privileged role; browsers have no direct table access.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres

# Same project URL as above; the anon key falls back to VITE_SUPABASE_ANON_KEY
SUPABASE_URL=https://<project-ref>.supabase.co
# Dashboard → Project Settings → API Keys → "service_role" (secret)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Optional, recommended: verify access tokens locally instead of calling Supabase
# Auth on every request (Dashboard → Project Settings → JWT Keys → legacy JWT secret).
# Leave empty if the project signs sessions with asymmetric keys.
SUPABASE_JWT_SECRET=

# Browser origin(s) allowed to call the API (comma-separated; REQUIRED in production:
# the API refuses to start without it) and the site URL
# used in e-mails and invite links
CORS_ORIGIN=https://<club-domain>
FRONTEND_URL=https://<club-domain>
# true when the API runs behind a proxy/load balancer (needed for per-IP rate limiting)
TRUST_PROXY=true

# Club time zone: the booking grid, e-mails and reports use it.
TZ=Africa/Tunis
CLUB_TIMEZONE=Africa/Tunis
# Name and address used in e-mails and push notifications
CLUB_NAME="<Club name>"
CLUB_ADDRESS="<Street, City>"

# Max write requests per IP per minute (0 = off)
RATE_LIMIT_WRITES_PER_MINUTE=60

# Transactional e-mails sent by the API (confirmations, reminders, invitations,
# tokens). Without RESEND_API_KEY they are only logged. Auth e-mails (confirm,
# reset) are sent by Supabase Auth: see docs/EMAIL_CONFIGURATION.md.
RESEND_API_KEY=
EMAIL_FROM="<Club name> <notifications@<club-domain>>"
EMAIL_REPLY_TO=contact@<club-domain>

# Web push (installable app). Generate once per club: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@<club-domain>

# Scheduled jobs (reminders, "match finished" e-mails; timing set in Réglages)
# true  = the API runs them every 5 minutes (long-running server)
# false = call POST /api/internal/jobs/run with header x-cron-secret from a cron
JOBS_ENABLED=true
CRON_SECRET=

# Public demo for prospective clubs (docs/DEMO_MODE.md). NEVER on a real club:
# the data is wiped and the invented club re-created every night.
DEMO_MODE=false
# Password of the two shared demo accounts, shown on the sign-in page (8+ characters)
DEMO_PASSWORD=
# Club-local hour of the nightly reset
DEMO_RESET_HOUR=4
